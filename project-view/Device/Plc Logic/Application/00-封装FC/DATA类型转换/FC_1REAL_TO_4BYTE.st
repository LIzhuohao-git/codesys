FUNCTION FC_1REAL_TO_4BYTE : BOOL
VAR_INPUT
	rIN:REAL;
END_VAR
VAR_OUTPUT
	byOUT0:BYTE;	
	byOUT1:BYTE;
	byOUT2:BYTE;	
	byOUT3:BYTE;	
END_VAR
VAR
	dw:DWORD;
	pdw:POINTER TO DWORD;
END_VAR
// --- implementation ---
pdw:=ADR(rIN);
dw:=pdw^;
byOUT0:=DWORD_TO_BYTE(SHR(dw,0));
byOUT1:=DWORD_TO_BYTE(SHR(dw,8));
byOUT2:=DWORD_TO_BYTE(SHR(dw,16));
byOUT3:=DWORD_TO_BYTE(SHR(dw,24));
FC_1REAL_TO_4BYTE :=TRUE;
END_FUNCTION
