FUNCTION FC_1REAL_TO_2WORD : BOOL
VAR_INPUT
	rIN:REAL;
END_VAR
VAR_OUTPUT
	wOUT0:WORD;
	wOUT1:WORD;		
END_VAR
VAR
	dw:DWORD;
	pdw:POINTER TO DWORD;
END_VAR
// --- implementation ---
pdw:=ADR(rIN);
dw:=pdw^;
wOUT0:=DWORD_TO_WORD(SHR(dw,0));
wOUT1:=DWORD_TO_WORD(SHR(dw,16));
FC_1REAL_TO_2WORD:=TRUE;
END_FUNCTION
