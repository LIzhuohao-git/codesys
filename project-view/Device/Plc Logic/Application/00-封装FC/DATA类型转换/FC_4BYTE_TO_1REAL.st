FUNCTION FC_4BYTE_TO_1REAL : REAL
VAR_INPUT
	byIN0:BYTE;
	byIN1:BYTE;
	byIN2:BYTE;
	byIN3:BYTE;	
END_VAR
VAR
	dw:DWORD;
	pr:POINTER TO REAL;
END_VAR
// --- implementation ---
dw:=SHL(BYTE_TO_DWORD(byIN3),24)+SHL(BYTE_TO_DWORD(byIN2),16)+SHL(BYTE_TO_DWORD(byIN1),8)+SHL(BYTE_TO_DWORD(byIN0),0);
pr:=ADR(dw);
FC_4BYTE_TO_1REAL:=pr^;
END_FUNCTION
